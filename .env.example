# =============================================================================
# NexusCRM Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys before running:
#   docker compose up --build
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=nexuscrm
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secret_2024

# --- pgAdmin ---
PGADMIN_EMAIL=admin@nexuscrm.io
PGADMIN_PASSWORD=admin

# --- LLM Provider (anthropic or openai) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- API Keys (provide at least one) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
